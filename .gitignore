node_modules/

# Secrets & env (never commit) — but keep the documented template
.env
.env.*
!.env.example
*.pem
# ...except the database CA. It is a public certificate, not a secret, and having
# it in the repo means the host needs no DB_CA_CERT env var (which mangles PEM
# newlines and silently drops you to an unverified TLS connection).
!ca.pem

# Local SQLite database (auto-seeded on boot; never committed) + WAL side-cars
local.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs & scratch
*.log
t1.txt
t2.txt
test_out.txt
tmp_*.js
backup/

# Dev notes & loose source images (kept local, not in repo)
Campus Care Plans*.txt
Not dont yet*.txt
*.pdf
nmu.jpg
NMU George Campus Facebook.png
NMU Mandela Stethascope.jpeg

