# CampusCare — environment variables (copy to .env locally; set these in your host's dashboard for deploy)
# NOTE: .env is gitignored. Never commit real secrets.

# ---- Database (managed MySQL, e.g. Aiven free tier) ----
DB_HOST=your-db-host.aivencloud.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=defaultdb
# Managed MySQL requires SSL. In production paste the provider's CA cert PEM here
# (as a single line with \n between lines), OR keep a ca.pem file at the repo root
# for local dev. If neither is set, the app still connects over TLS without chain
# verification.
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# ---- App ----
# Local dev port. In production the host injects PORT automatically — leave APP_PORT unset there.
APP_PORT=3000
# Set to "production" on the host so secure cookies + trust-proxy engage.
NODE_ENV=development
# Random 64-char hex string — the session signing secret.
SESSION_SEED=change_me_to_a_long_random_hex_string
# Public base URL of the deployed app (used for building video-room links / redirects).
APP_BASE_URL=http://localhost:3000

# ---- Daily.co (video consultations) — optional; only needed for Tier-2 video ----
DAILY_API_KEY=your_daily_api_key
# Your Daily subdomain (e.g. "campuscare" for campuscare.daily.co). This also drives
# the Permissions-Policy + CSP frame origin, so camera/mic work inside the call iframe.
DAILY_DOMAIN=your_daily_subdomain
DAILY_WEBHOOK_SECRET=your_webhook_shared_secret

# ---- MapTiler (health-trend map) ----
# Public browser key — protect via HTTP-origin restriction in the MapTiler dashboard.
MAPTILER_KEY=your_maptiler_key

# ---- Password reset (demo shortcut) ----
# There is no mail server, so the only way to deliver a reset link is to render it in
# the page. Anyone who knows a username could then reset that account, so the link is
# hidden whenever NODE_ENV=production. Set this to "true" ONLY to demo the flow on a
# deployed instance; otherwise the link is written to the server log instead.
# ALLOW_INSECURE_PASSWORD_RESET=false
