<%- include('../partials/header', { title: 'Health Trends' }) %>
<%- include('../partials/header', { title: 'Health Trends' }) %>
<link rel="stylesheet" href="/vendor/maplibre/maplibre-gl.css?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>" />
<%- include('../partials/navbar') %>

<main class="container page-wrapper layout-dashboard trends-page">
  <%- include('../partials/alerts') %>

  <header class="dash-hero dash-hero--bare trends-hero">
    <h1 class="trends-title">Campus Health Trends</h1>
    <p class="subtitle">A live density map of symptom reports across Gqeberha. Data is aggregated — no individual student is ever identifiable.</p>
  </header>

  <!-- ============================================================= -->
  <!-- HEATMAP — full-bleed density surface with floating glass chrome -->
  <!-- ============================================================= -->
  <section class="trends-map-stage" aria-label="Campus health heatmap">
    <div id="healthMap" class="trends-map-canvas"></div>

    <!-- Period selector (floating glass, top-left) -->
    <div class="map-overlay map-period-switch" role="group" aria-label="Time period">
      <% ['7d','1m','2m','6m','1y'].forEach(function(p){ var lbl = {'7d':'7 days','1m':'Month','2m':'2 months','6m':'6 months','1y':'Year'}[p]; %>
        <button type="button" data-map-period="<%= p %>" class="<%= p === period ? 'active' : '' %>"><%= lbl %></button>
      <% }); %>
    </div>

    <!-- Legend (floating glass, bottom-left) -->
    <div class="map-overlay map-legend" aria-hidden="true">
      <span class="map-legend-title">Report density</span>
      <div class="map-legend-ramp"></div>
      <div class="map-legend-labels"><span>Quiet</span><span>Outbreak</span></div>
    </div>

    <!-- Zone detail (floating glass, top-right — populated on zone click) -->
    <aside id="mapZoneDetail" class="map-overlay map-zone-detail" aria-live="polite">
      <p class="map-zone-hint">Hover the map to see a suburb; click anywhere for its breakdown.</p>
    </aside>
  </section>

  <!-- ============================================================= -->
  <!-- HEADLINE STATS                                                -->
  <!-- ============================================================= -->
  <div class="trends-stat-grid">
    <div class="stat-tile reveal">
      <span class="stat-tile-value"><%= stats.totalReports %></span>
      <span class="stat-tile-label">Reports in period</span>
    </div>
    <div class="stat-tile reveal">
      <span class="stat-tile-value"><%= stats.reporters %></span>
      <span class="stat-tile-label">Unique reporters</span>
    </div>
    <div class="stat-tile reveal">
      <span class="stat-tile-value stat-danger"><%= stats.highReports %></span>
      <span class="stat-tile-label">High-severity reports</span>
    </div>
    <div class="stat-tile reveal">
      <span class="stat-tile-value"><%= stats.activeZones %></span>
      <span class="stat-tile-label">Active zones</span>
    </div>
    <div class="stat-tile reveal stat-tile--wide">
      <span class="stat-tile-label">Busiest zone</span>
      <span class="stat-tile-value stat-hotspot">
        <%= stats.hotspot ? stats.hotspot.name : '—' %>
      </span>
      <% if (stats.hotspot) { %><span class="stat-tile-sub"><%= stats.hotspot.reports %> reports</span><% } %>
    </div>
  </div>

  <!-- ============================================================= -->
  <!-- CHARTS: timeline + severity + category                        -->
  <!-- ============================================================= -->
  <section class="content-card reveal trends-chart-timeline">
    <h2>Report volume over time</h2>
    <div class="chart-holder"><canvas id="timelineChart"></canvas></div>
  </section>

  <div class="trends-chart-pair">
    <section class="content-card reveal">
      <h2>Severity split</h2>
      <div class="chart-holder"><canvas id="severityChart"></canvas></div>
    </section>

    <section class="content-card reveal">
      <h2>By category</h2>
      <% if (symptomsByType.length > 0) { %>
        <div class="chart-holder"><canvas id="categoryChart"></canvas></div>
      <% } else { %>
        <p class="text-muted">No data available for this period.</p>
      <% } %>
    </section>
  </div>

  <!-- ============================================================= -->
  <!-- TOP CONDITIONS — filterable                                   -->
  <!-- ============================================================= -->
  <section class="content-card reveal" id="conditions">
    <div class="trends-table-head">
      <h2>Top reported conditions</h2>
      <form method="get" action="/trends#conditions" class="trends-filter-bar">
        <input type="hidden" name="period" value="<%= period %>">
        <select name="category" class="form-control" onchange="this.form.submit()">
          <option value="">All categories</option>
          <% categories.forEach(function(c){ %>
            <option value="<%= c %>" <%= c === category ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
        <select name="severity" class="form-control" onchange="this.form.submit()">
          <option value="">Any severity</option>
          <% ['Low','Moderate','High'].forEach(function(s){ %>
            <option value="<%= s %>" <%= s === severity ? 'selected' : '' %>><%= s %></option>
          <% }); %>
        </select>
        <% if (user.role === 'nurse' || user.role === 'admin') { %>
          <a href="/trends/export-csv" class="btn btn-secondary btn-sm">Export CSV</a>
        <% } %>
      </form>
    </div>

    <% if (topConditions.length > 0) { %>
      <table class="data-table trends-conditions-table">
        <thead>
          <tr><th>Symptom</th><th>Category</th><th>Tier</th><th>Reports</th><th>High</th><th>Meds</th></tr>
        </thead>
        <tbody>
          <% var _max = topConditions[0].Reports || 1; %>
          <% topConditions.forEach(function(row){ %>
            <tr>
              <td>
                <span class="cond-name"><%= row.SymptomName %></span>
                <span class="cond-bar" style="--pct: <%= Math.round((row.Reports / _max) * 100) %>%"></span>
              </td>
              <td><%= row.Type %></td>
              <td>Tier <%= row.Tier %></td>
              <td><strong><%= row.Reports %></strong></td>
              <td><%= row.HighCount || 0 %></td>
              <td><%= row.MedicationCount %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted">No conditions match these filters for this period.</p>
    <% } %>
  </section>
</main>

<!-- Config for the map bootstrap (map.js reads window.__mapConfig) -->
<script>
  window.__mapConfig = {
    maptilerKey: '<%= maptilerKey %>',
    center: <%- JSON.stringify(mapCenter) %>,
    zoom: <%= mapZoom %>,
    period: '<%= period %>'
  };
  window.__trendData = {
    timeline: <%- JSON.stringify(timeline) %>,
    severity: <%- JSON.stringify(severityBreakdown) %>,
    categories: {
      labels: <%- JSON.stringify(symptomsByType.map(function(r){ return r.Type; })) %>,
      data: <%- JSON.stringify(symptomsByType.map(function(r){ return r.Count; })) %>
    }
  };
</script>
<script src="/vendor/maplibre/maplibre-gl.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/map.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script src="/js/trends-charts.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>

<%- include('../partials/footer') %>
