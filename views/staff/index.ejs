<%- include('../partials/header', { title: 'Meet Our Staff' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Meet Our Staff</h1>
    <p class="subtitle">Get to know the nurses who keep our campus healthy.</p>
  </header>

  <% if (staffData.length > 0) { %>

    <% if (campuses.length > 1) { %>
      <div class="staff-filter" id="campusFilter">
        <button type="button" class="staff-pill active" data-campus="all">All</button>
        <% campuses.forEach(function(c) { %>
          <button type="button" class="staff-pill" data-campus="<%= c %>"><%= c %></button>
        <% }); %>
      </div>
    <% } %>

    <div class="staff-grid" id="staffGrid">
      <% staffData.forEach(function(nurse) { %>
        <section class="staff-card" data-campus="<%= nurse.campus || '' %>">
          <div class="staff-card-head">
            <div class="staff-avatar"><%= (nurse.firstName || '?').charAt(0).toUpperCase() %></div>
            <div class="staff-head-info">
              <h2 class="staff-name"><%= nurse.firstName %> <%= nurse.lastName %></h2>
              <% if (nurse.campus) { %><span class="staff-campus-badge"><%= nurse.campus %></span><% } %>
              <p class="staff-exp text-muted">
                <%= nurse.yearsExperience > 0 ? nurse.yearsExperience + ' years experience' : 'Campus Nurse' %>
              </p>
            </div>
          </div>

          <div class="staff-rating">
            <span class="star-rating-static">
              <% for (let i = 1; i <= 5; i++) { %><% if (nurse.averageRating && i <= Math.round(nurse.averageRating)) { %><span>&#9733;</span><% } else { %><span class="star-empty">&#9734;</span><% } %><% } %>
            </span>
            <span class="text-muted" style="font-size:0.8rem;">
              <%= nurse.averageRating ? nurse.averageRating + ' (' + nurse.ratingCount + ' review' + (nurse.ratingCount !== 1 ? 's' : '') + ')' : 'No ratings yet' %>
            </span>
          </div>

          <p class="staff-bio"><%= nurse.bio ? nurse.bio : 'No bio available yet.' %></p>

          <% if (nurse.reviews.length > 0) { %>
            <div class="staff-reviews-preview">
              <% nurse.reviews.forEach(function(review) { %>
                <div class="staff-review-snippet">
                  <span class="star-rating-static" style="font-size:0.85rem;">
                    <% for (let i = 1; i <= 5; i++) { %><% if (i <= review.score) { %><span>&#9733;</span><% } else { %><span class="star-empty">&#9734;</span><% } %><% } %>
                  </span>
                  <% if (review.comment) { %><span class="staff-review-text text-muted">"<%= review.comment %>"</span><% } %>
                </div>
              <% }); %>
            </div>
          <% } %>

          <a href="/staff/<%= nurse.staffNumber %>" class="btn btn-secondary btn-block staff-view-btn">View full profile &rarr;</a>
        </section>
      <% }); %>
    </div>

    <p class="text-muted text-center" id="noStaffMatch" style="display:none; margin-top:20px;">No nurses on this campus.</p>

  <% } else { %>
    <section class="content-card">
      <div class="empty-state">
        <div class="empty-state-icon">&#128105;&#8205;&#9877;&#65039;</div>
        <p class="empty-state-text">No staff profiles available yet.</p>
      </div>
    </section>
  <% } %>

</main>

<script>
(function () {
  var filter = document.getElementById('campusFilter');
  if (!filter) return;
  var cards = document.querySelectorAll('#staffGrid .staff-card');
  var noMatch = document.getElementById('noStaffMatch');
  filter.addEventListener('click', function (e) {
    var btn = e.target.closest('.staff-pill');
    if (!btn) return;
    var campus = btn.dataset.campus;
    filter.querySelectorAll('.staff-pill').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var shown = 0;
    cards.forEach(function (card) {
      var match = campus === 'all' || card.dataset.campus === campus;
      card.style.display = match ? '' : 'none';
      if (match) shown++;
    });
    if (noMatch) noMatch.style.display = shown === 0 ? 'block' : 'none';
  });
})();
</script>

<%- include('../partials/footer') %>
