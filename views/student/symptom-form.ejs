<%- include('../partials/header', { title: 'Symptom Checker' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Symptom Checker</h1>
    <p class="subtitle">Select your primary symptom and severity level for a Tier 1 health evaluation.</p>
  </header>

  <section class="content-card">
    <h2>Log Your Symptom</h2>
    <form action="/symptoms/evaluate" method="POST">
      <div class="form-group">
        <label for="symptomName">What symptom are you experiencing?</label>
        <select id="symptomName" name="symptomName" class="form-control" required>
          <option value="" disabled selected>-- Select a symptom --</option>
          <% symptoms.forEach(function(s) { %>
            <option value="<%= s.Name %>"><%= s.Name %> (<%= s.Type %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="severity">How severe are your symptoms?</label>
        <select id="severity" name="severity" class="form-control" required>
          <option value="" disabled selected>-- Select severity --</option>
          <option value="Low">Low - Mild discomfort</option>
          <option value="Moderate">Moderate - Noticeable impact on daily activities</option>
          <option value="High">High - Significant pain or impairment</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">Evaluate Symptoms</button>
    </form>
  </section>

</main>

<%- include('../partials/footer') %>
