<%- include('../partials/header', { title: 'Symptom History' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Symptom History</h1>
    <p class="subtitle">Your previous symptom checks and reported severity.</p>
  </header>

  <%- include('../partials/back-button') %>

  <% if (logs.length > 0) { %>
    <section class="content-card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Symptoms</th>
            <th>Severity</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) { %>
            <tr>
              <td><%= new Date(log.LogDate).toLocaleString('en-ZA', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
              <td>
                <% if (log.SymptomNames) { %>
                  <% log.SymptomNames.split(', ').forEach(function(name) { %>
                    <span class="symptom-summary-tag" style="font-size:0.72rem; padding: 2px 8px; margin: 2px;"><%= name %></span>
                  <% }); %>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td><span class="severity-badge severity-<%= (log.Severity || 'moderate').toLowerCase() %>"><%= log.Severity %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  <% } else { %>
    <section class="content-card">
      <div class="empty-state">
        <div class="empty-state-icon"><span class="inline-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'symptoms' }) %></span></div>
        <p class="empty-state-text">No symptom checks recorded yet. Try the Symptom Checker to get personalised recommendations.</p>
        <a href="/symptoms" class="btn btn-primary">Check Symptoms</a>
      </div>
    </section>
  <% } %>

</main>

<%- include('../partials/footer') %>
