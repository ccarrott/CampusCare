<%- include('../partials/header', { title: 'Symptom History' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>My Symptom History</h1>
    <p class="subtitle">A record of all your symptom checks on CampusCare.</p>
  </header>

  <% if (logs.length > 0) { %>
    <section class="content-card">
      <h2>Recent Checks (<%= logs.length %> records)</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Symptom</th>
            <th>Severity</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(log) { %>
            <tr>
              <td><%= new Date(log.LogDate).toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= log.SymptomName %></td>
              <td>
                <span class="severity-badge severity-<%= log.Severity.toLowerCase() %>"><%= log.Severity %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  <% } else { %>
    <section class="content-card">
      <p class="text-muted text-center">No symptom checks recorded yet. Use the <a href="/symptoms">Symptom Checker</a> to get started.</p>
    </section>
  <% } %>

  <div class="mt-2">
    <a href="/symptoms" class="btn btn-primary">Check Symptoms Now</a>
  </div>

</main>

<%- include('../partials/footer') %>
