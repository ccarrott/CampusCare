<%- include('../partials/header', { title: 'Recommendations' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Your Health Recommendations</h1>
    <p class="subtitle">Based on your reported symptom and severity level.</p>
  </header>

  <% if (escalation) { %>
    <!-- Escalation Warning -->
    <section class="alert alert-danger">
      <strong>Clinical Escalation Required:</strong>
      Your symptom severity or tier level indicates you should book a Tier 2 nurse consultation immediately.
      <br>
      <a href="/consultations/book" class="btn btn-danger mt-1" style="display: inline-block;">Book Consultation Now</a>
    </section>
  <% } %>

  <% if (symptom) { %>
    <!-- Symptom Details Card -->
    <section class="content-card">
      <h2>Symptom Information</h2>
      <ul class="profile-details">
        <li>
          <span class="detail-label">Symptom</span>
          <span class="detail-value"><%= symptom.Name %></span>
        </li>
        <li>
          <span class="detail-label">Description</span>
          <span class="detail-value"><%= symptom.Description || 'No description available' %></span>
        </li>
        <li>
          <span class="detail-label">Type</span>
          <span class="detail-value"><%= symptom.Type || 'General' %></span>
        </li>
        <li>
          <span class="detail-label">Tier Level</span>
          <span class="detail-value">Tier <%= symptom.Tier %></span>
        </li>
        <li>
          <span class="detail-label">Common Cause</span>
          <span class="detail-value"><%= symptom.Cause || 'Various' %></span>
        </li>
        <li>
          <span class="detail-label">Reported Severity</span>
          <span class="detail-value"><%= severity %></span>
        </li>
      </ul>
    </section>

    <!-- OTC Medication Recommendations -->
    <section class="content-card">
      <h2>Recommended OTC Medications</h2>

      <% if (medications.length > 0) { %>
        <div class="medication-list">
          <% medications.forEach(function(med) { %>
            <div class="medication-card">
              <h3 class="medication-name"><%= med.Name %></h3>
              <ul class="profile-details">
                <li>
                  <span class="detail-label">Treats</span>
                  <span class="detail-value"><%= med.SymptomsTreated || 'Related symptoms' %></span>
                </li>
              </ul>
            </div>
          <% }); %>
        </div>
        <p class="text-muted mt-2" style="font-style: italic;">Always consult a healthcare professional for dosage guidance and before taking any medication.</p>
      <% } else { %>
        <p class="text-muted">No OTC medications are currently mapped for this symptom. Please consult a nurse.</p>
      <% } %>
    </section>
  <% } %>

  <div class="mt-3">
    <a href="/symptoms" class="btn btn-secondary">Check Another Symptom</a>
    <a href="/" class="btn btn-primary">Back to Dashboard</a>
  </div>

</main>

<%- include('../partials/footer') %>
