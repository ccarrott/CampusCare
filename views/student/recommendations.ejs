<%- include('../partials/header', { title: 'Recommendations' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Your Recommendations</h1>
    <p class="subtitle">Based on the <%= selectedSymptoms.length %> symptom<%= selectedSymptoms.length > 1 ? 's' : '' %> you reported.</p>
  </header>

  <!-- Tier Escalation Banner -->
  <% if (maxTier >= 3) { %>
    <section class="content-card" style="border: 2px solid var(--status-danger);">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <span style="font-size:2.5rem;">&#128680;</span>
        <div>
          <h2 style="color: var(--status-danger); border-bottom:none; margin:0; padding:0; font-size:1.4rem;">Go to Your Nearest Emergency Room</h2>
          <p class="text-muted" style="margin:4px 0 0;">One or more of your symptoms requires immediate emergency care.</p>
        </div>
      </div>

      <!-- Hospital Results -->
      <div id="hospitalResult" style="display:none;">
        <div class="content-card" style="margin-bottom:12px; border-left: 4px solid var(--status-danger);">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
            <div>
              <h3 style="margin:0;" id="hospitalName"></h3>
              <p class="text-muted" style="margin:4px 0;" id="hospitalAddress"></p>
              <p style="margin:4px 0; font-size:0.9rem;"><strong id="hospitalPhone"></strong></p>
            </div>
            <span class="status-badge status-danger" id="hospitalDistance"></span>
          </div>
          <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
            <a id="directionsLink" href="#" target="_blank" class="btn btn-danger">Get Directions</a>
          </div>
        </div>
      </div>

      <!-- Other hospitals -->
      <details id="otherHospitals" style="display:none; margin-top:12px;">
        <summary style="cursor:pointer; font-weight:600; font-size:0.9rem; color:var(--text-muted);">Other Emergency Rooms</summary>
        <div id="hospitalList" style="margin-top:8px;"></div>
      </details>

      <!-- Loading / fallback -->
      <p id="locationStatus" style="margin-top:12px; font-size:0.85rem; color:var(--text-muted);">
        &#128205; Requesting your location...
      </p>
    </section>

    <script>
    (function() {
      // Only REAL hospitals with emergency departments
      var HOSPITALS = [
        { name: 'Livingstone Hospital', type: 'Public', lat: -33.9580, lon: 25.6100, address: 'Standford Rd, Korsten', phone: '041 405 9111' },
        { name: 'Provincial Hospital', type: 'Public', lat: -33.9470, lon: 25.6050, address: 'Buckingham Rd, Central', phone: '041 392 3911' },
        { name: 'Dora Nginza Hospital', type: 'Public', lat: -33.8720, lon: 25.5640, address: 'Spondo St, Zwide', phone: '041 406 4111' },
        { name: 'Life Mercantile Hospital', type: 'Private', lat: -33.9620, lon: 25.5890, address: 'Alfred Rd, Mill Park', phone: '041 395 2222' },
        { name: 'Netcare Greenacres Hospital', type: 'Private', lat: -33.9530, lon: 25.5780, address: 'Cape Rd, Newton Park', phone: '041 390 7000' }
      ];

      function haversine(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
          Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) *
          Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      }

      function renderHospitals(lat, lon, detected) {
        var sorted = HOSPITALS.map(function(h) {
          return Object.assign({}, h, { distance: haversine(lat, lon, h.lat, h.lon) });
        }).sort(function(a, b) { return a.distance - b.distance; });

        var nearest = sorted[0];

        document.getElementById('hospitalResult').style.display = 'block';
        document.getElementById('hospitalName').textContent = nearest.name;
        document.getElementById('hospitalAddress').textContent = nearest.address;
        document.getElementById('hospitalPhone').textContent = nearest.phone;
        document.getElementById('hospitalDistance').textContent = nearest.distance.toFixed(1) + ' km away';
        // Turn-by-turn directions FROM the user's location TO the exact hospital.
        // dir/?api=1 gives directions (not a plain search); destination = name + coords + area
        // so Google resolves the precise place rather than a fuzzy text match.
        document.getElementById('directionsLink').href = dirUrl(nearest);

        if (detected) {
          document.getElementById('locationStatus').innerHTML = '&#9989; Based on your current location';
        } else {
          document.getElementById('locationStatus').innerHTML = '&#9888;&#65039; Location unavailable — showing hospitals nearest to NMU campus. <br>Call <strong>10177</strong> (national ambulance) if unsure where to go. <button type="button" id="retryLocation" class="btn btn-secondary" style="margin-top:8px; padding:4px 12px; font-size:0.85rem;">Retry location</button>';
          var retry = document.getElementById('retryLocation');
          if (retry) retry.addEventListener('click', requestLocation);
        }

        // Other hospitals
        if (sorted.length > 1) {
          document.getElementById('otherHospitals').style.display = 'block';
          document.getElementById('hospitalList').innerHTML = sorted.slice(1).map(function(h) {
            return '<div style="padding:10px 0; border-bottom:1px solid var(--border-color);">' +
              '<strong>' + h.name + '</strong> <span class="text-muted">(' + h.type + ')</span><br>' +
              '<span class="text-muted" style="font-size:0.85rem;">' + h.address + '</span> — <strong>' + h.distance.toFixed(1) + ' km</strong> — ' +
              '<a href="' + dirUrl(h) + '" target="_blank">Directions</a>' +
              '</div>';
          }).join('');
        }
      }

      // Build a Google Maps directions URL to a specific hospital.
      function dirUrl(h) {
        return 'https://www.google.com/maps/dir/?api=1&destination=' +
          encodeURIComponent(h.name + ', ' + h.address + ', Gqeberha') +
          '&destination_ll=' + h.lat + ',' + h.lon;
      }

      function requestLocation() {
        if (!navigator.geolocation) { renderHospitals(-33.9860, 25.6600, false); return; }
        navigator.geolocation.getCurrentPosition(
          function(pos) { renderHospitals(pos.coords.latitude, pos.coords.longitude, true); },
          function() { renderHospitals(-33.9860, 25.6600, false); },
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
        );
      }

      requestLocation();
    })();
    </script>
  <% } else if (maxTier >= 2) { %>
    <div class="alert alert-warning" style="border-left: 4px solid var(--status-warning);">
      <strong>You need to book a nurse consultation.</strong><br>
      One or more of your symptoms requires professional assessment. OTC medication alone is not appropriate for these symptoms.
      <% if (typeof escalationReasons !== 'undefined' && escalationReasons && escalationReasons.length > 0) { %>
        <ul style="margin:8px 0 0; padding-left:18px; font-size:0.9rem;">
          <% escalationReasons.forEach(function(reason) { %><li><%= reason %></li><% }); %>
        </ul>
      <% } %>
      <% if (typeof otherText !== 'undefined' && otherText) { %>
        <p style="margin:8px 0 0; font-size:0.9rem;">You reported: <em>"<%= otherText %>"</em></p>
      <% } %>
      <a href="/consultations/book" class="btn btn-primary" style="margin-top: 8px; display: inline-block;">Book Consultation Now</a>
    </div>
  <% } %>

  <!-- Selected Symptoms Summary -->
  <section class="content-card">
    <h2>Symptoms Reported</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 6px;">
      <% selectedSymptoms.forEach(function(sym) { %>
        <span class="symptom-summary-tag">
          <%= sym.Name %>
          <% if (sym.Tier === 2) { %><span class="tier-dot tier-dot-2"></span><% } %>
          <% if (sym.Tier >= 3) { %><span class="tier-dot tier-dot-3"></span><% } %>
        </span>
      <% }); %>
    </div>
    <p class="text-muted mt-2">Severity: <strong><%= severity %></strong></p>
  </section>

  <!-- OTC Recommendations (Ranked by Relevance) -->
  <% if (medications.length > 0 && maxTier < 3) { %>
    <section class="content-card">
      <h2>Recommended OTC Medications</h2>
      <p class="text-muted mb-2">Ranked by how many of your symptoms each medication covers. Available at campus pharmacy, Clicks, or Dis-Chem.</p>

      <div class="medication-list">
        <% medications.forEach(function(med, idx) { %>
          <div class="medication-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
              <h3 class="medication-name"><%= med.Name %></h3>
              <span class="severity-badge severity-<%= med.RelevanceScore >= 3 ? 'high' : med.RelevanceScore >= 2 ? 'moderate' : 'low' %>" style="font-size: 0.7rem;">
                Covers <%= med.RelevanceScore %> of your symptoms
              </span>
            </div>
            <p class="medication-desc"><%= med.Description %></p>
            <% if (med.covers && med.covers.length > 0) { %>
              <p style="margin-top: 8px; font-size: 0.82rem;">
                <strong>Helps with:</strong>
                <% med.covers.forEach(function(name, i) { %>
                  <span class="symptom-summary-tag" style="font-size:0.72rem; padding: 2px 8px;"><%= name %></span>
                <% }); %>
              </p>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% } else if (maxTier >= 3) { %>
    <section class="content-card">
      <h2>Supportive Care Only</h2>
      <p class="text-muted">Given the severity of your symptoms, OTC medications alone are not sufficient. Please see a healthcare professional. In the meantime, stay hydrated (Rehidrat Sachets if available) and rest.</p>
    </section>
  <% } else { %>
    <section class="content-card">
      <p class="text-muted">No specific OTC medications found for your symptom combination. Consider booking a nurse consultation for personalised advice.</p>
    </section>
  <% } %>

  <!-- Disclaimer -->
  <section class="content-card" style="border-left: 3px solid var(--text-muted);">
    <p class="text-muted" style="font-size: 0.82rem; margin: 0;">
      <strong>Disclaimer:</strong> These recommendations are for informational purposes only and do not constitute medical advice. Always consult a healthcare professional if symptoms persist or worsen.
    </p>
  </section>

  <!-- Actions -->
  <div class="mt-3" style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="/symptoms" class="btn btn-primary">Check Again</a>
    <a href="/symptoms/history" class="btn btn-secondary">View History</a>
    <% if (maxTier >= 2) { %>
      <a href="/consultations/book" class="btn btn-success">Book Consultation Now</a>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
