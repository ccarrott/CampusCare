<%- include('../partials/header', { title: 'Edit Profile' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <header class="page-header">
    <h1>Edit Your Profile</h1>
    <p class="subtitle">Update your bio and experience. This information is visible to students on the "Meet Our Staff" page.</p>
  </header>

  <%- include('../partials/back-button') %>

  <section class="content-card">
    <h2>Public Profile</h2>
    <form action="/management/nurse/edit-bio" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="bio">Bio <span class="text-muted" style="font-weight:normal;">(max 300 characters)</span></label>
        <textarea id="bio" name="bio" class="form-control" rows="4" maxlength="300" placeholder="Tell students a bit about yourself, your specialties, and your approach to care..."><%= bio %></textarea>
        <p class="text-muted" style="font-size:0.8rem; margin-top:4px;"><span id="charCount"><%= (bio || '').length %></span> / 300</p>
      </div>

      <div class="form-group">
        <label for="yearsExperience">Years of Experience</label>
        <input type="number" id="yearsExperience" name="yearsExperience" class="form-control" min="0" max="50" value="<%= yearsExperience %>" style="max-width: 120px;">
      </div>

      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/management/nurse/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </form>
  </section>

</main>

<script>
(function() {
  const bio = document.getElementById('bio');
  const counter = document.getElementById('charCount');
  bio.addEventListener('input', function() {
    counter.textContent = this.value.length;
  });
})();
</script>

<%- include('../partials/footer') %>
