<%- include('../partials/header', { title: 'Nurse Dashboard' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <header class="page-header">
    <h1>Clinical Dashboard</h1>
    <p class="subtitle">Manage patient appointments, update status, and record consultation notes.</p>
    <form action="/management/nurse/demo-consultation" method="POST" style="margin-top:12px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary">&#127909; Create Demo Video Consultation</button>
      <span class="text-muted" style="margin-left:8px; font-size:0.85rem;">Instantly books &amp; confirms an online consultation (joinable now) to showcase the video feature.</span>
    </form>
  </header>

  <!-- Rating Summary -->
  <section class="content-card" style="display:flex; align-items:center; gap:24px; flex-wrap:wrap;">
    <div>
      <h2 style="border-bottom:none; margin-bottom:4px; padding-bottom:0;">Your Rating Summary</h2>
      <% if (nurseAverage) { %>
        <div class="star-rating-static" style="font-size:1.8rem;">
          <% for (let i = 1; i <= 5; i++) { %>
            <% if (i <= Math.round(nurseAverage)) { %><span>&#9733;</span><% } else { %><span class="star-empty">&#9734;</span><% } %>
          <% } %>
        </div>
      <% } else { %>
        <div class="star-rating-static" style="font-size:1.8rem;">
          <span class="star-empty">&#9734;&#9734;&#9734;&#9734;&#9734;</span>
        </div>
      <% } %>
    </div>
    <div>
      <% if (nurseAverage) { %>
        <span class="metric-value" style="font-size:2rem;"><%= nurseAverage %></span>
        <span class="text-muted"> / 5</span>
        <p class="text-muted" style="margin:4px 0 0;">from <%= nurseRatingCount %> consultation<%= nurseRatingCount !== 1 ? 's' : '' %></p>
      <% } else { %>
        <p class="text-muted">No ratings yet. Complete consultations to receive feedback.</p>
      <% } %>
    </div>
  </section>

  <% if (appointments.length > 0) { %>

    <section class="content-card">
      <h2>Your Schedule (<%= appointments.length %> appointments)</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Patient</th>
            <th>Type</th>
            <th>Date & Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(function(apt) { %>
            <% const status = apt.Status || 'Pending'; %>
            <% const aptDate = new Date(apt.Time); %>
            <% const isToday = aptDate.toDateString() === new Date().toDateString(); %>
            <% const isUpcoming = (aptDate - Date.now() < 86400000) && (aptDate > Date.now()); %>
            <tr class="<%= status === 'Cancelled' ? 'row-cancelled' : '' %> <%= isToday && status !== 'Cancelled' ? 'row-today' : '' %> <%= isUpcoming && status !== 'Cancelled' ? 'row-upcoming' : '' %>">
              <td>
                <%= apt.StudentFirstName %> <%= apt.StudentLastName %>
                <a href="/management/nurse/patient/<%= apt.StudentNumber %>/history" style="font-size:0.7rem; margin-left:4px;" title="View patient symptom history">&#128196;</a>
              </td>
              <td><%= apt.AppointmentType %></td>
              <td><%= new Date(apt.Time).toLocaleString('en-ZA', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
              <td><span class="status-badge status-<%= status.toLowerCase() %>"><%= status %></span></td>
              <td>
                <div class="action-btns">

                  <% if (status === 'Pending') { %>
                    <form action="/management/nurse/appointment/status" method="POST" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="appointmentId" value="<%= apt.AppointmentID %>">
                      <input type="hidden" name="status" value="Confirmed">
                      <button type="submit" class="action-btn action-btn-confirm">Confirm</button>
                    </form>
                    <form action="/management/nurse/appointment/status" method="POST" style="display:inline;" onsubmit="return confirm('Cancel this appointment?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="appointmentId" value="<%= apt.AppointmentID %>">
                      <input type="hidden" name="status" value="Cancelled">
                      <button type="submit" class="action-btn action-btn-cancel">Cancel</button>
                    </form>
                  <% } %>

                  <% if (status === 'Confirmed') { %>
                    <form action="/management/nurse/appointment/status" method="POST" style="display:inline;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="appointmentId" value="<%= apt.AppointmentID %>">
                      <input type="hidden" name="status" value="Completed">
                      <button type="submit" class="action-btn action-btn-complete">Complete</button>
                    </form>
                    <form action="/management/nurse/appointment/status" method="POST" style="display:inline;" onsubmit="return confirm('Cancel this appointment?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="appointmentId" value="<%= apt.AppointmentID %>">
                      <input type="hidden" name="status" value="Cancelled">
                      <button type="submit" class="action-btn action-btn-cancel">Cancel</button>
                    </form>
                    <% if (apt.AppointmentType === 'Online') { %>
                      <%
                        var t = new Date(apt.Time).getTime();
                        var withinWindow = Date.now() >= (t - 15 * 60 * 1000) && Date.now() <= (t + 60 * 60 * 1000);
                      %>
                      <% if (withinWindow) { %>
                        <a href="/consultations/<%= apt.AppointmentID %>/join" class="action-btn action-btn-teams">Join Consultation</a>
                      <% } else { %>
                        <span class="action-btn action-btn-disabled"><%= apt.RoomName ? 'Room ready' : 'Room pending' %></span>
                      <% } %>
                    <% } %>
                  <% } %>

                  <%/* No actions for Completed or Cancelled */%>

                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- Consultation Notes -->
    <% const activeApts = appointments.filter(a => a.Status !== 'Cancelled'); %>
    <% if (activeApts.length > 0) { %>
      <section class="content-card">
        <h2>Consultation Notes</h2>
        <form action="/management/nurse/appointment/notes" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="appointmentId">Select Appointment</label>
            <select id="appointmentId" name="appointmentId" class="form-control" required>
              <option value="" disabled selected>-- Select --</option>
              <% activeApts.forEach(function(apt) { %>
                <option value="<%= apt.AppointmentID %>"><%= apt.StudentFirstName %> <%= apt.StudentLastName %> — <%= new Date(apt.Time).toLocaleDateString('en-ZA') %> (<%= apt.Status || 'Pending' %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="Record consultation findings, recommendations, follow-up actions..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save Notes</button>
        </form>
      </section>
    <% } %>

  <% } else { %>
    <section class="content-card">
      <div class="empty-state">
        <div class="empty-state-icon">&#128197;</div>
        <p class="empty-state-text">No patients scheduled. Check back after students book consultations.</p>
        <a href="/management/nurse/availability" class="btn btn-primary">Set Your Availability</a>
      </div>
    </section>
  <% } %>

</main>

<%- include('../partials/footer') %>
