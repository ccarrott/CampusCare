<%- include('../partials/header', { title: 'Set Your Location' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper layout-focused">
  <%- include('../partials/alerts') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <header class="page-header">
    <h1>Set Your Location</h1>
    <p class="subtitle">Drop a pin on the map where you stay. This helps us show health trends in your area.</p>
  </header>

  <%- include('../partials/back-button') %>

  <section class="content-card">
    <div id="locationMap" style="height: 420px; border-radius: 8px; overflow: hidden; margin-bottom: 16px;"></div>

    <div id="locationInfo" style="display:none; margin-bottom: 16px;">
      <div class="alert alert-success" style="margin-bottom:0;">
        <strong>Zone:</strong> <span id="zoneName">—</span>
      </div>
    </div>

    <form action="/profile/location" method="POST" id="locationForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="latitude" id="latInput">
      <input type="hidden" name="longitude" id="lonInput">
      <div class="profile-actions">
        <button type="submit" class="btn btn-primary" id="saveBtn" disabled>Save Location</button>
        <a href="/profile" class="btn btn-secondary">Skip for now</a>
      </div>
    </form>
  </section>

</main>

<link rel="stylesheet" href="/vendor/maplibre/maplibre-gl.css?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>" />
<script src="/vendor/maplibre/maplibre-gl.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>
<script>
  window.__pinConfig = {
    maptilerKey: '<%= maptilerKey %>',
    container: 'locationMap',
    latInput: 'latInput',
    lonInput: 'lonInput',
    saveBtn: 'saveBtn',
    infoBox: 'locationInfo',
    zoneLabel: 'zoneName',
    currentLat: <%= currentLat ? currentLat : 'null' %>,
    currentLon: <%= currentLon ? currentLon : 'null' %>
  };
</script>
<script src="/js/pin-picker.js?v=<%= typeof assetV !== 'undefined' ? assetV : '1' %>"></script>

<%- include('../partials/footer') %>
