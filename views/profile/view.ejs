<%- include('../partials/header', { title: 'My Profile' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper layout-focused">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>My Profile</h1>
    <p class="subtitle">View your personal account information.</p>
  </header>

  <% if (profile) { %>

    <!-- Profile Details Card -->
    <section class="content-card">
      <h2>Account Details</h2>
      <ul class="profile-details">
        <% if (user.role === 'student') { %>
          <li><span class="detail-label">Student Number</span><span class="detail-value"><%= profile.StudentNumber.replace(/^s/i, '') %></span></li>
          <li><span class="detail-label">Username</span><span class="detail-value"><%= profile.StudentNumber %></span></li>
          <li><span class="detail-label">First Name</span><span class="detail-value"><%= profile.FirstName %></span></li>
          <li><span class="detail-label">Last Name</span><span class="detail-value"><%= profile.LastName %></span></li>
          <li><span class="detail-label">Email</span><span class="detail-value"><%= profile.StudentNumber %>@mandela.ac.za</span></li>
          <li><span class="detail-label">Location</span><span class="detail-value"><%= profile.Latitude ? 'Pin set ✓' : 'Not set' %> <a href="/profile/location" style="font-size:0.8rem;">Update</a></span></li>
          <li><span class="detail-label">Medical History</span><span class="detail-value"><%= profile.MedicalHistory || 'None on file' %></span></li>
        <% } else if (user.role === 'nurse') { %>
          <li><span class="detail-label">Staff Number</span><span class="detail-value"><%= profile.StaffNumber %></span></li>
          <li><span class="detail-label">First Name</span><span class="detail-value"><%= profile.FirstName %></span></li>
          <li><span class="detail-label">Last Name</span><span class="detail-value"><%= profile.LastName %></span></li>
          <li><span class="detail-label">Email</span><span class="detail-value"><%= profile.Email || 'Not set' %></span></li>
          <li><span class="detail-label">Phone</span><span class="detail-value"><%= profile.PhoneNumber || 'Not set' %></span></li>
          <li><span class="detail-label">Campus</span><span class="detail-value"><%= profile.Campus || 'Not set' %></span></li>
          <li><span class="detail-label">Clinic</span><span class="detail-value"><%= profile.ClinicName || 'Not assigned' %></span></li>
        <% } else if (user.role === 'admin') { %>
          <li><span class="detail-label">Staff Number</span><span class="detail-value"><%= profile.StaffNumber %></span></li>
          <li><span class="detail-label">Name</span><span class="detail-value"><%= profile.Name %></span></li>
          <li><span class="detail-label">Role</span><span class="detail-value">Administrator</span></li>
        <% } %>
      </ul>
    </section>

    <% if (user.role === 'student') { %>
      <section class="content-card">
        <h2>Account Actions</h2>
        <div class="profile-actions">
          <a href="/profile/edit" class="btn btn-primary">Edit Profile</a>
          <form action="/profile/delete" method="POST" style="display: inline-block;" onsubmit="return confirm('Permanently delete your account? This cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">Delete Account</button>
          </form>
        </div>
      </section>
    <% } %>

    <% if (user.role === 'nurse') { %>
      <section class="content-card">
        <h2>Public Profile</h2>
        <p class="text-muted mb-2">This info is visible to students on the "Meet Our Staff" page.</p>
        <form action="/profile/update-bio" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="bio">Bio <span class="text-muted" style="font-weight:normal;">(max 300 characters)</span></label>
            <textarea id="bio" name="bio" class="form-control" rows="3" maxlength="300" placeholder="Tell students about yourself..."><%= profile.Bio || '' %></textarea>
            <p class="text-muted" style="font-size:0.8rem; margin-top:4px;"><span id="bioCharCount"><%= (profile.Bio || '').length %></span> / 300</p>
          </div>
          <div class="form-group">
            <label for="yearsExperience">Years of Experience</label>
            <input type="number" id="yearsExperience" name="yearsExperience" class="form-control" min="0" max="50" value="<%= profile.YearsExperience || 0 %>" style="max-width: 120px;">
          </div>
          <button type="submit" class="btn btn-primary">Save Public Profile</button>
        </form>
      </section>
      <script>
        document.getElementById('bio').addEventListener('input', function() {
          document.getElementById('bioCharCount').textContent = this.value.length;
        });
      </script>
    <% } %>

    <!-- Password Change (all roles) -->
    <section class="content-card">
      <h2>Change Password</h2>
      <form action="/profile/change-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" class="form-control" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="newPassword">New Password (min 6 chars)</label>
            <input type="password" id="newPassword" name="newPassword" class="form-control" required minlength="6">
          </div>
          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required minlength="6">
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Update Password</button>
      </form>
    </section>

  <% } else { %>
    <section class="content-card">
      <p class="text-muted text-center">No profile data available.</p>
    </section>
  <% } %>

</main>

<%- include('../partials/footer') %>
