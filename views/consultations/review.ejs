<%- include('../partials/header', { title: 'Review Nurse' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper layout-focused">
  <%- include('../partials/alerts') %>

  <div class="alert alert-success">
    <strong>Appointment booked successfully!</strong>
  </div>

  <header class="page-header">
    <h1>Review Your Nurse</h1>
    <p class="subtitle">Would you like to leave a review for <strong><%= appointment.NurseFirstName %> <%= appointment.NurseLastName %></strong>?</p>
  </header>

  <section class="content-card">
    <h2>Appointment Summary</h2>
    <ul class="profile-details">
      <li><span class="detail-label">Appointment ID</span><span class="detail-value"><%= appointment.AppointmentID %></span></li>
      <li><span class="detail-label">Type</span><span class="detail-value"><%= appointment.AppointmentType %></span></li>
      <li><span class="detail-label">Nurse</span><span class="detail-value"><%= appointment.NurseFirstName %> <%= appointment.NurseLastName %></span></li>
      <li><span class="detail-label">Date & Time</span><span class="detail-value"><%= new Date(appointment.Time).toLocaleString('en-ZA', { dateStyle: 'full', timeStyle: 'short' }) %></span></li>
      <% if (appointment.AppointmentType === 'Physical' && appointment.Campus) { %>
        <li><span class="detail-label">Campus</span><span class="detail-value"><%= appointment.Campus %> Campus</span></li>
      <% } %>
      <% if (appointment.AppointmentType === 'Online' && appointment.PreferredLanguage) { %>
        <li><span class="detail-label">Preferred Language</span><span class="detail-value"><%= appointment.PreferredLanguage %></span></li>
      <% } %>
      <li><span class="detail-label">Status</span><span class="detail-value">Pending (awaiting nurse confirmation)</span></li>
    </ul>
  </section>

  <!-- Review Decision -->
  <section class="content-card mt-3">
    <h2>Leave a Review?</h2>
    <p class="text-muted">Your feedback helps improve the quality of care for all students.</p>

    <div id="reviewDecision">
      <button type="button" class="btn btn-primary" id="yesReviewBtn">Yes, leave a review</button>
      <a href="/consultations/my-appointments" class="btn btn-secondary">No thanks, skip</a>
    </div>

    <!-- Review Form (hidden until "Yes" is clicked) -->
    <form action="/consultations/review" method="POST" id="reviewForm" style="display: none;" class="mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="appointmentId" value="<%= appointment.AppointmentID %>">
      <input type="hidden" name="staffNumber" value="<%= appointment.StaffNumber %>">

      <div class="form-group">
        <label for="rating">Rating (1-5 stars)</label>
        <div class="star-rating" id="starRating">
          <span class="star" data-value="1">&#9733;</span>
          <span class="star" data-value="2">&#9733;</span>
          <span class="star" data-value="3">&#9733;</span>
          <span class="star" data-value="4">&#9733;</span>
          <span class="star" data-value="5">&#9733;</span>
        </div>
        <input type="hidden" name="rating" id="ratingValue" required>
      </div>

      <div class="form-group">
        <label for="reviewText">Comment (Optional)</label>
        <textarea id="reviewText" name="reviewText" class="form-control" rows="4" placeholder="Share your experience with this nurse..."></textarea>
      </div>

      <div class="mt-2">
        <button type="submit" class="btn btn-primary" id="submitReviewBtn" disabled>Submit Review</button>
        <a href="/consultations/my-appointments" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </section>

</main>

<style>
  .star-rating {
    font-size: 2rem;
    cursor: pointer;
    display: inline-flex;
    gap: 0.25rem;
  }
  .star-rating .star {
    color: #ccc;
    transition: color 0.2s;
  }
  .star-rating .star.active,
  .star-rating .star:hover,
  .star-rating .star:hover ~ .star {
    color: #ccc;
  }
  .star-rating .star.active {
    color: #f5a623;
  }
  .star-rating:hover .star {
    color: #ccc;
  }
  .star-rating .star:hover,
  .star-rating .star:hover ~ .star {
    color: #ccc;
  }
  /* Hover fills from left to hovered star */
  .star-rating .star {
    color: #ccc;
  }
  .star-rating[data-hover] .star {
    color: #ccc;
  }
</style>

<script>
(function() {
  const yesBtn = document.getElementById('yesReviewBtn');
  const reviewForm = document.getElementById('reviewForm');
  const reviewDecision = document.getElementById('reviewDecision');
  const stars = document.querySelectorAll('.star-rating .star');
  const ratingInput = document.getElementById('ratingValue');
  const submitBtn = document.getElementById('submitReviewBtn');
  const reviewText = document.getElementById('reviewText');

  // Show review form
  yesBtn.addEventListener('click', function() {
    reviewDecision.style.display = 'none';
    reviewForm.style.display = 'block';
  });

  // Star rating interaction
  let selectedRating = 0;

  stars.forEach(function(star) {
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.dataset.value);
      ratingInput.value = selectedRating;
      updateStars();
      checkSubmitReady();
    });

    star.addEventListener('mouseenter', function() {
      const hoverVal = parseInt(this.dataset.value);
      stars.forEach(function(s) {
        s.style.color = parseInt(s.dataset.value) <= hoverVal ? '#f5a623' : '#ccc';
      });
    });
  });

  document.querySelector('.star-rating').addEventListener('mouseleave', function() {
    updateStars();
  });

  function updateStars() {
    stars.forEach(function(s) {
      s.style.color = parseInt(s.dataset.value) <= selectedRating ? '#f5a623' : '#ccc';
      if (parseInt(s.dataset.value) <= selectedRating) {
        s.classList.add('active');
      } else {
        s.classList.remove('active');
      }
    });
  }

  // Enable submit when both rating and text are filled
  reviewText.addEventListener('input', checkSubmitReady);

  function checkSubmitReady() {
    submitBtn.disabled = !(selectedRating > 0);
  }
})();
</script>

<%- include('../partials/footer') %>
