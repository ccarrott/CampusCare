<%- include('../partials/header', { title: 'My Appointments' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper layout-feed">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>My Appointments</h1>
    <p class="subtitle">View, manage, and rate your consultations.</p>
  </header>

  <% if (appointments.length > 0) { %>

    <%- include('../partials/consult-progress-section', { appointments: appointments }) %>

    <section class="content-card reveal">
      <h2>Appointment History</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Nurse</th>
            <th>Date & Time</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(function(apt) { %>
            <% const status = apt.Status || 'Pending'; %>
            <% const aptDate = new Date(apt.Time); %>
            <% const isToday = aptDate.toDateString() === new Date().toDateString(); %>
            <% const isUpcoming = (aptDate - Date.now() < 86400000) && (aptDate > Date.now()); %>
            <tr class="<%= status === 'Cancelled' ? 'row-cancelled' : '' %> <%= isToday && status !== 'Cancelled' ? 'row-today' : '' %> <%= isUpcoming && status !== 'Cancelled' ? 'row-upcoming' : '' %>">
              <td><%= apt.AppointmentType %></td>
              <td><%= apt.NurseFirstName %> <%= apt.NurseLastName %></td>
              <td><%= new Date(apt.Time).toLocaleString('en-ZA', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
              <td><span class="status-badge status-<%= status.toLowerCase() %>"><%= status %></span></td>
              <td>
                <%
                  var t = new Date(apt.Time).getTime();
                  var withinWindow = Date.now() >= (t - 15*60*1000) && Date.now() <= (t + 60*60*1000);
                  var isRated = (ratedIds || []).includes(apt.AppointmentID);
                %>
                <div class="kebab" data-kebab>
                  <button type="button" class="kebab-btn" aria-haspopup="true" aria-expanded="false" aria-label="Actions" onclick="toggleApptMenu(this)">&#8942;</button>
                  <div class="kebab-menu" role="menu">
                    <% if ((status === 'Pending' || status === 'Confirmed') && apt.AppointmentType === 'Online') { %>
                      <% if (status === 'Confirmed' && withinWindow) { %>
                        <a href="/consultations/<%= apt.AppointmentID %>/join" class="kebab-item" role="menuitem">Join consultation</a>
                      <% } else if (status === 'Confirmed') { %>
                        <span class="kebab-item kebab-item-muted">Join opens 15 min before</span>
                      <% } else { %>
                        <span class="kebab-item kebab-item-muted">Awaiting confirmation</span>
                      <% } %>
                    <% } %>

                    <a href="/staff/<%= apt.StaffNumber %>" class="kebab-item" role="menuitem">View nurse</a>

                    <% if (status === 'Completed' && !isRated) { %>
                      <button type="button" class="kebab-item"
                        data-appointment-id="<%= apt.AppointmentID %>"
                        data-nurse-name="<%= apt.NurseFirstName %> <%= apt.NurseLastName %>"
                        data-date="<%= new Date(apt.Time).toLocaleDateString('en-ZA', { dateStyle: 'medium' }) %>"
                        onclick="openRatingModal(this)">Rate</button>
                    <% } else if (status === 'Completed' && isRated) { %>
                      <span class="kebab-item kebab-item-muted"><span class="inline-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'check' }) %></span> Rated</span>
                    <% } %>

                    <% if (status === 'Pending' || status === 'Confirmed') { %>
                      <form action="/consultations/cancel" method="POST" onsubmit="return confirm('Cancel this appointment?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="appointmentId" value="<%= apt.AppointmentID %>">
                        <button type="submit" class="kebab-item kebab-item-danger" role="menuitem">Cancel</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>

    <!-- Rating Modal (hidden, populated by JS) -->
    <div id="ratingModal" class="modal-backdrop" style="display:none;" onclick="closeRatingModal(event)">
      <div class="modal-card" onclick="event.stopPropagation()">
        <button type="button" class="modal-close" onclick="closeRatingModal()">&times;</button>
        <h2 class="modal-title">Rate Your Consultation</h2>
        <p class="text-muted modal-subtitle" id="modalSubtitle"></p>
        <form action="/consultations/rate" method="POST" id="ratingModalForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="appointmentId" id="modalAppointmentId">
          <input type="hidden" name="score" id="modalScoreInput">
          <div class="form-group">
            <label>Your Rating</label>
            <div class="star-rating" id="modalStarRating">
              <span class="star" data-value="1">&#9733;</span>
              <span class="star" data-value="2">&#9733;</span>
              <span class="star" data-value="3">&#9733;</span>
              <span class="star" data-value="4">&#9733;</span>
              <span class="star" data-value="5">&#9733;</span>
            </div>
          </div>
          <div class="form-group">
            <label for="modalComment">Comments (Optional)</label>
            <textarea id="modalComment" name="ratingDescription" class="form-control" rows="3" placeholder="Share your experience..."></textarea>
          </div>
          <button type="submit" class="btn btn-success btn-block" id="modalSubmitBtn" disabled>Submit Rating</button>
        </form>
      </div>
    </div>

  <% } else { %>
    <section class="content-card">
      <div class="empty-state">
        <div class="empty-state-icon"><span class="inline-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'calendar' }) %></span></div>
        <p class="empty-state-text">You have no appointments yet. Book your first consultation to get started.</p>
        <a href="/consultations/book" class="btn btn-primary">Book Your First Appointment</a>
      </div>
    </section>
  <% } %>

</main>

<script>
// Kebab menu (My Appointments row actions)
function toggleApptMenu(btn) {
  var wrap = btn.closest('[data-kebab]');
  var isOpen = wrap.classList.contains('open');
  document.querySelectorAll('[data-kebab].open').forEach(function(k){ k.classList.remove('open'); var b=k.querySelector('.kebab-btn'); if(b) b.setAttribute('aria-expanded','false'); });
  if (!isOpen) { wrap.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
}
document.addEventListener('click', function(e){
  if (!e.target.closest('[data-kebab]')) {
    document.querySelectorAll('[data-kebab].open').forEach(function(k){ k.classList.remove('open'); var b=k.querySelector('.kebab-btn'); if(b) b.setAttribute('aria-expanded','false'); });
  }
});
document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ document.querySelectorAll('[data-kebab].open').forEach(function(k){ k.classList.remove('open'); }); } });
</script>

<script>
(function() {
  // Star rating interaction
  const stars = document.querySelectorAll('#modalStarRating .star');
  const scoreInput = document.getElementById('modalScoreInput');
  const submitBtn = document.getElementById('modalSubmitBtn');
  let selectedRating = 0;

  stars.forEach(function(star) {
    star.addEventListener('click', function() {
      selectedRating = parseInt(this.dataset.value);
      scoreInput.value = selectedRating;
      updateStars();
      submitBtn.disabled = false;
    });
    star.addEventListener('mouseenter', function() {
      const hoverVal = parseInt(this.dataset.value);
      stars.forEach(function(s) {
        s.style.color = parseInt(s.dataset.value) <= hoverVal ? '#ffcc00' : '#94a3b8';
      });
    });
  });

  document.getElementById('modalStarRating').addEventListener('mouseleave', updateStars);

  function updateStars() {
    stars.forEach(function(s) {
      s.style.color = parseInt(s.dataset.value) <= selectedRating ? '#ffcc00' : '#94a3b8';
    });
  }

  // Modal open/close
  window.openRatingModal = function(btn) {
    selectedRating = 0;
    scoreInput.value = '';
    submitBtn.disabled = true;
    updateStars();
    document.getElementById('modalComment').value = '';
    document.getElementById('modalAppointmentId').value = btn.dataset.appointmentId;
    document.getElementById('modalSubtitle').textContent = btn.dataset.nurseName + ' — ' + btn.dataset.date;
    document.getElementById('ratingModal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
  };

  window.closeRatingModal = function(e) {
    if (e && e.target !== document.getElementById('ratingModal')) return;
    document.getElementById('ratingModal').style.display = 'none';
    document.body.style.overflow = '';
  };

  // Escape key closes modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') window.closeRatingModal();
  });
})();
</script>

<%- include('../partials/footer') %>
