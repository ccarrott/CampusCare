<%- include('../partials/header', { title: 'Video Consultation' }) %>
<%- include('../partials/navbar') %>

<script>document.body.classList.add('immersive-page');</script>

<main>
  <div class="layout-immersive">

    <!-- The video fills the whole stage -->
    <div id="video-container" class="immersive-stage"></div>

    <!-- Top-left: who + when, as a floating glass pill -->
    <div class="immersive-overlay overlay-top-left immersive-context">
      <strong>
        <% if (user.role === 'nurse') { %>
          <%= appointment.StudentFirstName ? (appointment.StudentFirstName + ' ' + appointment.StudentLastName) : 'Your patient' %>
        <% } else { %>
          <%= appointment.NurseFirstName ? ('Nurse ' + appointment.NurseFirstName + ' ' + appointment.NurseLastName) : 'Your nurse' %>
        <% } %>
      </strong>
      <span class="ctx-sub">&middot; <%= new Date(appointment.Time).toLocaleString('en-ZA', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
    </div>

    <!-- Top-center: connection status + cam/mic readiness (glass toast) -->
    <div id="call-status" class="immersive-overlay overlay-top-center immersive-toast">
      <span class="inline-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'camera' }) %></span> Connecting&hellip; your browser will ask for camera &amp; microphone access — please choose <strong>Allow</strong>.
    </div>

    <!-- Bottom-right: leave control -->
    <div class="immersive-overlay overlay-bottom-right">
      <a href="<%= returnUrl %>" class="immersive-leave" id="leaveBtn"><span class="inline-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'close' }) %></span> Leave &amp; Return</a>
    </div>

  </div>
</main>

<!-- Daily.co Prebuilt SDK: local (committed) first, CDN fallback if it fails to load -->
<script src="/vendor/daily/daily-iframe.js"
        onerror="var s=document.createElement('script');s.src='https://unpkg.com/@daily-co/daily-js@0.92.2/dist/daily-iframe.js';document.head.appendChild(s);"></script>
<script>
  (function () {
    // Server-provided values: a room URL and a SHORT-LIVED, per-user token.
    // The secret DAILY_API_KEY is never sent to the browser.
    var ROOM_URL = <%- JSON.stringify(roomUrl) %>;
    var MEETING_TOKEN = <%- JSON.stringify(meetingToken) %>;
    var RETURN_URL = <%- JSON.stringify(returnUrl) %>;

    var statusEl = document.getElementById('call-status');
    var container = document.getElementById('video-container');

    // Update the floating status toast while preserving its glass overlay styling.
    var STATUS_BASE = 'immersive-overlay overlay-top-center immersive-toast';
    function setStatus(html, state) {
      statusEl.className = STATUS_BASE + (state ? ' status-' + state : '');
      statusEl.innerHTML = html;
    }

    if (!window.DailyIframe) {
      setStatus('Could not load the video library. Check your connection and refresh.', 'error');
      return;
    }

    var callFrame = window.DailyIframe.createFrame(container, {
      iframeStyle: { width: '100%', height: '100%', border: '0' },
      showLeaveButton: true
    });

    callFrame.join({ url: ROOM_URL, token: MEETING_TOKEN })
      .then(function () {
        setStatus('Connected. If your nurse has not admitted you yet, please wait in the lobby.', 'ok');
        // Fade the toast away shortly after a successful connect so it doesn't linger.
        setTimeout(function () { statusEl.style.display = 'none'; }, 5000);
      })
      .catch(function (err) {
        setStatus('Unable to join the consultation room. It may have expired. Please return and try again.', 'error');
        console.error('[Daily] join failed:', err);
      });

    callFrame.on('left-meeting', function () {
      try { callFrame.destroy(); } catch (e) {}
      window.location.href = RETURN_URL;
    });

    // Manual leave via our button also tears down the frame.
    document.getElementById('leaveBtn').addEventListener('click', function () {
      try { callFrame.destroy(); } catch (e) {}
    });
  })();
</script>

<%- include('../partials/footer') %>
