<%- include('../partials/header', { title: isEdit ? 'Edit Student' : 'Add Student' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1><%= isEdit ? 'Edit Student' : 'Add New Student' %></h1>
    <p class="subtitle"><%= isEdit ? 'Update student account details.' : 'Create a new student account.' %></p>
  </header>

  <%- include('../partials/back-button') %>

  <section class="content-card" style="max-width: 600px;">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="<%= isEdit ? '/management/admin/students/' + student.StudentNumber + '/update' : '/management/admin/students/add' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="studentNumber">Username <span class="text-muted" style="font-weight:normal;">(student number, e.g. s229001020)</span></label>
        <input type="text" id="studentNumber" name="studentNumber" class="form-control" 
          value="<%= student ? student.StudentNumber || student.studentNumber || '' : '' %>"
          <%= isEdit ? 'readonly' : 'required' %> placeholder="e.g. s229001020">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="firstName">First Name</label>
          <input type="text" id="firstName" name="firstName" class="form-control" required
            value="<%= student ? student.FirstName || student.firstName || '' : '' %>" placeholder="John">
        </div>
        <div class="form-group">
          <label for="lastName">Last Name</label>
          <input type="text" id="lastName" name="lastName" class="form-control" required
            value="<%= student ? student.LastName || student.lastName || '' : '' %>" placeholder="Doe">
        </div>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" class="form-control"
          value="<%= student ? student.Email || student.email || '' : '' %>" placeholder="s229001020@mandela.ac.za">
      </div>

      <div class="form-group">
        <label for="medicalHistory">Medical History</label>
        <textarea id="medicalHistory" name="medicalHistory" class="form-control" rows="2"
          placeholder="e.g. Asthma, No known allergies"><%= student ? student.MedicalHistory || student.medicalHistory || '' : '' %></textarea>
      </div>

      <% if (!isEdit) { %>
        <div class="form-group">
          <label for="password">Password (min 6 characters)</label>
          <input type="password" id="password" name="password" class="form-control" required minlength="6">
        </div>
      <% } %>

      <div class="profile-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Add Student' %></button>
        <a href="/management/admin/students" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </section>

</main>

<%- include('../partials/footer') %>
