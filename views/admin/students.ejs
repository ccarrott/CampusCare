<%- include('../partials/header', { title: 'Manage Students' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <header class="page-header">
    <h1>Manage Students</h1>
    <p class="subtitle">View, add, or remove student accounts.</p>
  </header>

  <section class="content-card reveal">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <form action="/management/admin/students" method="GET" style="display: flex; gap: 8px;">
        <input type="text" name="search" class="form-control" placeholder="Search by name or ID..." value="<%= search %>" style="width: 250px;">
        <button type="submit" class="btn btn-secondary">Search</button>
      </form>
      <a href="/management/admin/students/add" class="btn btn-primary">+ Add Student</a>
    </div>

    <% if (students.length > 0) { %>
      <table class="data-table sortable">
        <thead>
          <tr>
            <th>Username</th>
            <th>Name</th>
            <th>Email</th>
            <th class="no-sort"></th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(s) { %>
            <tr>
              <td><%= s.StudentNumber %></td>
              <td><%= s.FirstName %> <%= s.LastName %></td>
              <td><%= s.StudentNumber %>@mandela.ac.za</td>
              <td class="table-actions">
                <button class="kebab-btn" aria-label="Actions menu" onclick="toggleKebab(this)">&#8942;</button>
                <div class="kebab-menu">
                  <a href="/management/admin/students/<%= s.StudentNumber %>/view" class="kebab-item">View</a>
                  <form action="/management/admin/students/<%= s.StudentNumber %>/delete" method="POST" onsubmit="return confirm('Delete student <%= s.FirstName %> <%= s.LastName %>? This cannot be undone.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="kebab-item kebab-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted text-center">No students found.</p>
    <% } %>
  </section>

</main>

<script>
function toggleKebab(btn) {
  document.querySelectorAll('.kebab-menu.open').forEach(function(m) { m.classList.remove('open'); });
  var menu = btn.nextElementSibling;
  menu.classList.toggle('open');
}
document.addEventListener('click', function(e) {
  if (!e.target.closest('.table-actions')) {
    document.querySelectorAll('.kebab-menu.open').forEach(function(m) { m.classList.remove('open'); });
  }
});
</script>
<script src="/js/sortable-table.js"></script>

<%- include('../partials/footer') %>
