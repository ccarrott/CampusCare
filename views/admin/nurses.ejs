<%- include('../partials/header', { title: 'Manage Nurses' }) %>
<%- include('../partials/navbar') %>

<main class="container page-wrapper">
  <%- include('../partials/alerts') %>

  <header class="page-header">
    <h1>Manage Nurses</h1>
    <p class="subtitle">View, add, edit, or remove nurse staff accounts.</p>
  </header>

  <!-- Pending Nurse Reviews Moderation Queue (relocated from the report page) -->
  <% if (typeof pendingNurseReviews !== 'undefined' && pendingNurseReviews.length > 0) { %>
    <section class="content-card reveal mb-3">
      <h2>Pending Nurse Reviews (<%= pendingNurseReviews.length %>)</h2>
      <p class="text-muted mb-2">These nurse reviews need approval before they appear on "Meet Our Staff".</p>
      <table class="data-table">
        <thead>
          <tr>
            <th>Nurse</th>
            <th>Score</th>
            <th>Review</th>
            <th>Student</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% pendingNurseReviews.forEach(function(r) { %>
            <tr>
              <td><%= r.NurseFirstName %> <%= r.NurseLastName %></td>
              <td>
                <span class="star-rating-static">
                  <% for (let i = 1; i <= 5; i++) { %><% if (i <= r.Rating) { %><span>&#9733;</span><% } else { %><span class="star-empty">&#9734;</span><% } %><% } %>
                </span>
              </td>
              <td><%= r.ReviewText %></td>
              <td><%= r.StudentFirstName %> <%= r.StudentLastName %></td>
              <td>
                <div class="action-btns">
                  <form action="/management/admin/review/approve" method="POST" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="reviewId" value="<%= r.ReviewID %>">
                    <button type="submit" class="action-btn action-btn-complete">Approve</button>
                  </form>
                  <form action="/management/admin/review/reject" method="POST" style="display:inline;" onsubmit="return confirm('Reject this review?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="reviewId" value="<%= r.ReviewID %>">
                    <button type="submit" class="action-btn action-btn-cancel">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </section>
  <% } %>

  <section class="content-card reveal">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <form action="/management/admin/nurses" method="GET" style="display: flex; gap: 8px;">
        <input type="text" name="search" class="form-control" placeholder="Search by name, staff no, email, campus..." value="<%= typeof search !== 'undefined' ? search : '' %>" style="width: 280px;">
        <button type="submit" class="btn btn-secondary">Search</button>
      </form>
      <a href="/management/admin/nurses/add" class="btn btn-primary">+ Add Nurse</a>
    </div>

    <% if (nurses.length > 0) { %>
      <table class="data-table sortable">
        <thead>
          <tr>
            <th>Staff No.</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Campus</th>
            <th>Clinic</th>
            <th class="no-sort"></th>
          </tr>
        </thead>
        <tbody>
          <% nurses.forEach(function(n) { %>
            <tr>
              <td><%= n.StaffNumber %></td>
              <td><%= n.FirstName %> <%= n.LastName %></td>
              <td><%= n.PhoneNumber || '—' %></td>
              <td><%= n.Email || '—' %></td>
              <td><%= n.Campus || '—' %></td>
              <td><%= n.ClinicName || '—' %></td>
              <td class="table-actions">
                <button class="kebab-btn" aria-label="Actions menu" onclick="toggleKebab(this)">&#8942;</button>
                <div class="kebab-menu">
                  <a href="/management/admin/nurses/<%= n.StaffNumber %>/edit" class="kebab-item">Edit</a>
                  <form action="/management/admin/nurses/<%= n.StaffNumber %>/delete" method="POST" onsubmit="return confirm('Delete nurse <%= n.FirstName %> <%= n.LastName %>? Cannot delete if they have appointments.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="kebab-item kebab-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-muted text-center"><%= (typeof search !== 'undefined' && search) ? 'No nurses match your search.' : 'No nurses registered.' %></p>
    <% } %>
  </section>

</main>

<script>
function toggleKebab(btn) {
  document.querySelectorAll('.kebab-menu.open').forEach(function(m) { m.classList.remove('open'); });
  var menu = btn.nextElementSibling;
  menu.classList.toggle('open');
}
document.addEventListener('click', function(e) {
  if (!e.target.closest('.table-actions')) {
    document.querySelectorAll('.kebab-menu.open').forEach(function(m) { m.classList.remove('open'); });
  }
});
</script>
<script src="/js/sortable-table.js"></script>

<%- include('../partials/footer') %>
