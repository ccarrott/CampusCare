<!-- Sidebar Navigation -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <img src="/images/nmu-george.png" alt="CampusCare" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
    </div>
    <h2 class="sidebar-brand">CampusCare</h2>
  </div>

  <nav class="sidebar-nav">
    <% if (typeof user !== 'undefined' && user) { %>

      <% if (user.role === 'student') { %>
        <a href="/" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'home' }) %></span>
          <span class="sidebar-label">Home</span>
        </a>
        <a href="/symptoms" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'symptoms' }) %></span>
          <span class="sidebar-label">Symptom Checker</span>
        </a>
        <a href="/consultations/book" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'book' }) %></span>
          <span class="sidebar-label">Book Consultation</span>
        </a>
        <a href="/consultations/my-appointments" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'appointment' }) %></span>
          <span class="sidebar-label">My Appointments</span>
        </a>
        <a href="/trends" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'trend' }) %></span>
          <span class="sidebar-label">Health Trends</span>
        </a>
        <a href="/staff" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'meet' }) %></span>
          <span class="sidebar-label">Meet Our Staff</span>
        </a>

        <div class="sidebar-spacer"></div>

        <a href="/profile" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'profile' }) %></span>
          <span class="sidebar-label">Profile</span>
        </a>

      <% } else if (user.role === 'nurse') { %>
        <a href="/" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'home' }) %></span>
          <span class="sidebar-label">Home</span>
        </a>
        <a href="/management/nurse/dashboard" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'appointment' }) %></span>
          <span class="sidebar-label">Clinical Dashboard</span>
        </a>
        <a href="/management/nurse/availability" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'book' }) %></span>
          <span class="sidebar-label">Availability</span>
        </a>
        <a href="/trends" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'trend' }) %></span>
          <span class="sidebar-label">Health Trends</span>
        </a>

        <div class="sidebar-spacer"></div>

        <a href="/profile" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'profile' }) %></span>
          <span class="sidebar-label">Profile</span>
        </a>

      <% } else if (user.role === 'admin') { %>
        <a href="/" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'home' }) %></span>
          <span class="sidebar-label">Home</span>
        </a>
        <a href="/management/admin/reports" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'report' }) %></span>
          <span class="sidebar-label">Reports</span>
        </a>
        <a href="/management/admin/students" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'manage.student' }) %></span>
          <span class="sidebar-label">Manage Students</span>
        </a>
        <a href="/management/admin/nurses" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'manage.nurse' }) %></span>
          <span class="sidebar-label">Manage Nurses</span>
        </a>
        <a href="/trends" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'trend' }) %></span>
          <span class="sidebar-label">Health Trends</span>
        </a>

        <div class="sidebar-spacer"></div>

        <a href="/profile" class="sidebar-link">
          <span class="sidebar-icon"><%- include('icon', { name: 'profile' }) %></span>
          <span class="sidebar-label">Profile</span>
        </a>
      <% } %>

      <a href="/auth/logout" class="sidebar-link sidebar-logout">
        <span class="sidebar-icon"><%- include('icon', { name: 'logout' }) %></span>
        <span class="sidebar-label">Logout</span>
      </a>

    <% } else { %>
      <a href="/auth/login" class="sidebar-link">
        <span class="sidebar-icon"><%- include('icon', { name: 'profile' }) %></span>
        <span class="sidebar-label">Login</span>
      </a>
      <a href="/auth/register" class="sidebar-link">
        <span class="sidebar-icon"><%- include('icon', { name: 'profile' }) %></span>
        <span class="sidebar-label">Register</span>
      </a>
    <% } %>
  </nav>
</aside>

<!-- Theme toggle: fixed bottom-right (Fixup 3), app-wide -->
<button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
  <span class="theme-icon theme-icon--dark"><%- include('icon', { name: 'darkmode' }) %></span>
  <span class="theme-icon theme-icon--light"><%- include('icon', { name: 'lightmode' }) %></span>
</button>

<!-- Main Content Wrapper (closed in footer.ejs) -->
<div class="mobile-backdrop" id="mobileBackdrop"></div>
<button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
  <span></span><span></span><span></span>
</button>
<div class="main-content" id="main-content">
