<%- include('../partials/auth-header', { title: 'Forgot Password' }) %>

    <div class="auth-card">
      <h2 class="auth-title">Forgot Password</h2>
      <p class="text-muted mb-2">Enter your Student or Staff Number to receive a reset link.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%- success %></div>
      <% } %>

      <form action="/auth/forgot-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="idNumber">Your Username</label>
          <input type="text" id="idNumber" name="idNumber" class="form-control" required placeholder="e.g. s999000001 or NUR001">
        </div>

        <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
      </form>

      <div class="auth-links">
        <a href="/auth/login">Back to Sign In</a>
      </div>
    </div>

<%- include('../partials/auth-footer') %>
