<%- include('../partials/auth-header', { title: 'Reset Password' }) %>

    <div class="auth-card">
      <h2 class="auth-title">Reset Password</h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (token) { %>
        <p class="text-muted mb-2">Enter your new password below.</p>

        <form action="/auth/reset-password/<%= token %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="password">New Password (min 6 characters)</label>
            <input type="password" id="password" name="password" class="form-control" required minlength="6" autocomplete="new-password">
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required minlength="6">
          </div>

          <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
        </form>
      <% } else { %>
        <p class="text-muted">This reset link is invalid or has expired.</p>
      <% } %>

      <div class="auth-links">
        <a href="/auth/login">Back to Sign In</a>
      </div>
    </div>

<%- include('../partials/auth-footer') %>
