<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CampusCare Hub - Student Registration</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f6f8; }
    .card { max-width: 450px; margin: 0 auto; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .form-group { margin-bottom: 12px; }
    label { display: block; margin-bottom: 4px; font-weight: bold; font-size: 14px; }
    input, textarea { width: 100%; padding: 8px; box-sizing: border-box; }
    button { width: 100%; padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; margin-top: 10px; }
    .error { color: red; margin-bottom: 15px; }
    .link { text-align: center; margin-top: 15px; display: block; font-size: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Student Registration</h2>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label for="studentNumber">Student Number:</label>
        <input type="text" id="studentNumber" name="studentNumber" required placeholder="e.g. 226205096">
      </div>

      <div class="row">
        <div class="form-group">
          <label for="firstName">First Name:</label>
          <input type="text" id="firstName" name="firstName" required placeholder="e.g. John">
        </div>
        <div class="form-group">
          <label for="lastName">Last Name:</label>
          <input type="text" id="lastName" name="lastName" required placeholder="e.g. Doe">
        </div>
      </div>

      <div class="form-group">
        <label for="address">Address / Residence:</label>
        <input type="text" id="address" name="address" placeholder="e.g. Campus Residence Room 12">
      </div>

      <div class="form-group">
        <label for="medicalHistory">Medical History (Optional):</label>
        <textarea id="medicalHistory" name="medicalHistory" rows="2" placeholder="e.g. Asthma, Penicillin allergy"></textarea>
      </div>

      <div class="form-group">
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required>
      </div>

      <button type="submit">Register Account</button>
    </form>

    <a href="/auth/login" class="link">Already registered? Sign in here</a>
  </div>
</body>
</html>