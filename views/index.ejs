<%- include('./partials/header', { title: 'Dashboard' }) %>
<%- include('./partials/navbar') %>

<% if (user.role === 'student') { %><span id="requestLocationFlag" hidden></span><% } %>

<main class="container page-wrapper layout-dashboard">
  <%- include('./partials/alerts') %>

  <header class="dash-hero dash-hero--bare">
    <h1 id="dashboardGreeting" class="dash-greeting"
      data-firstname="<%= user.firstName || '' %>"
      data-lastname="<%= user.lastName || '' %>"
      data-role="<%= user.role %>"
      data-name="<%= user.name %>">
    </h1>
  </header>

  <% if (user.role === 'student' && typeof appointments !== 'undefined') { %>
    <%- include('./partials/consult-progress-section', { appointments: appointments }) %>
  <% } %>

  <% if (user.role === 'student') { %>
    <!-- First-use Welcome Card (dismissed via localStorage) -->
    <div class="welcome-card" id="welcomeCard" style="display:none;">
      <button class="welcome-dismiss" id="welcomeDismiss" aria-label="Dismiss welcome message">&times;</button>
      <h2>Welcome to Campus Care, <%= user.firstName || user.name %>!</h2>
      <p>Here are 3 things you can do right now:</p>
      <div class="welcome-actions">
        <a href="/symptoms" class="btn">Check Symptoms</a>
        <a href="/consultations/book" class="btn">Book a Consultation</a>
        <a href="/trends" class="btn">Explore Health Trends</a>
      </div>
    </div>
    <script>
    (function() {
      if (!localStorage.getItem('campuscare_welcomed')) {
        document.getElementById('welcomeCard').style.display = 'block';
      }
      document.getElementById('welcomeDismiss').addEventListener('click', function() {
        localStorage.setItem('campuscare_welcomed', '1');
        document.getElementById('welcomeCard').style.display = 'none';
      });
    })();
    </script>
  <% } %>

  <!-- About CampusCare — informational, the same story for every role -->
  <section class="content-card reveal">
    <h2>About Campus Care</h2>
    <p class="text-muted">
      Campus Care is Nelson Mandela University's health platform, built to ease the pressure on
      campus clinics by meeting students where they are. Care is organised into three tiers, so
      the right level of help is always a step away — from quick self-care guidance to a nurse
      consultation to full clinical escalation.
    </p>
  </section>

  <div class="dashboard-grid">
    <section class="content-card reveal">
      <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'symptoms' }) %></span>
      <h2>Tier 1 — Self-Care &amp; Support</h2>
      <p class="text-muted">
        Check your symptoms and get instant over-the-counter medication guidance, plus a live
        campus health-trend map so you can see what's going around.
      </p>
    </section>

    <section class="content-card reveal">
      <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'book' }) %></span>
      <h2>Tier 2 — Nurse Consultations</h2>
      <p class="text-muted">
        Book a 15-minute in-person or online consultation with a campus nurse, see real-time
        availability, and share honest feedback through moderated reviews.
      </p>
    </section>

    <section class="content-card reveal">
      <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'clinical' }) %></span>
      <h2>Tier 3 — Clinical &amp; Admin</h2>
      <p class="text-muted">
        When a case needs more, nurses manage schedules and patient progress while admins handle
        moderation, operational reporting, and nearest-clinic guidance.
      </p>
    </section>
  </div>

</main>

<%- include('./partials/footer') %>
