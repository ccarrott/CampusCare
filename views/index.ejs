<%- include('./partials/header', { title: 'Dashboard' }) %>
<%- include('./partials/navbar') %>

<% if (user.role === 'student') { %><span id="requestLocationFlag" hidden></span><% } %>

<main class="container page-wrapper layout-dashboard">
  <%- include('./partials/alerts') %>

  <header class="dash-hero dash-hero--bare">
    <h1 id="dashboardGreeting" class="dash-greeting"
      data-firstname="<%= user.firstName || '' %>"
      data-lastname="<%= user.lastName || '' %>"
      data-role="<%= user.role %>"
      data-name="<%= user.name %>">
    </h1>
  </header>

  <% if (user.role === 'student' && typeof appointments !== 'undefined') { %>
    <%- include('./partials/consult-progress-section', { appointments: appointments }) %>
  <% } %>

  <% if (user.role === 'student') { %>

    <!-- First-use Welcome Card (dismissed via localStorage) -->
    <div class="welcome-card" id="welcomeCard" style="display:none;">
      <button class="welcome-dismiss" id="welcomeDismiss" aria-label="Dismiss welcome message">&times;</button>
      <h2>Welcome to Campus Care, <%= user.firstName || user.name %>!</h2>
      <p>Here are 3 things you can do right now:</p>
      <div class="welcome-actions">
        <a href="/symptoms" class="btn">Check Symptoms</a>
        <a href="/consultations/book" class="btn">Book a Consultation</a>
        <a href="/trends" class="btn">Explore Health Trends</a>
      </div>
    </div>
    <script>
    (function() {
      if (!localStorage.getItem('campuscare_welcomed')) {
        document.getElementById('welcomeCard').style.display = 'block';
      }
      document.getElementById('welcomeDismiss').addEventListener('click', function() {
        localStorage.setItem('campuscare_welcomed', '1');
        document.getElementById('welcomeCard').style.display = 'none';
      });
    })();
    </script>

    <div class="dashboard-grid dashboard-grid--quad">
      <section class="content-card reveal card-clickable">
        <a href="/symptoms" class="card-stretch" aria-label="Symptom Checker"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'symptoms' }) %></span>
        <h2>Symptom Checker</h2>
        <p class="text-muted">Check your symptoms and get instant OTC medication recommendations.</p>
        <a href="/symptoms" class="btn btn-primary">Check Symptoms</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/consultations/book" class="card-stretch" aria-label="Book Consultation"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'book' }) %></span>
        <h2>Book Consultation</h2>
        <p class="text-muted">Schedule a 15-minute in-person or online appointment with a campus nurse.</p>
        <a href="/consultations/book" class="btn btn-primary">Book Now</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/consultations/my-appointments" class="card-stretch" aria-label="My Appointments"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'appointment' }) %></span>
        <h2>My Appointments</h2>
        <p class="text-muted">View your upcoming and past consultations, and rate completed visits.</p>
        <a href="/consultations/my-appointments" class="btn btn-primary">View Appointments</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/trends" class="card-stretch" aria-label="Campus Health Trends"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'trend' }) %></span>
        <h2>Campus Health Trends</h2>
        <p class="text-muted">See what's going around campus — aggregated health data and facility info.</p>
        <a href="/trends" class="btn btn-primary">View Trends</a>
      </section>
    </div>

  <% } else if (user.role === 'nurse') { %>

    <div class="dashboard-grid">
      <section class="content-card reveal card-clickable">
        <a href="/management/nurse/dashboard" class="card-stretch" aria-label="Clinical Dashboard"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'clinical' }) %></span>
        <h2>Clinical Dashboard</h2>
        <p class="text-muted">Manage your patient schedule, view appointments, and start video consultations.</p>
        <a href="/management/nurse/dashboard" class="btn btn-primary">View Schedule</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/trends" class="card-stretch" aria-label="Health Trends"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'trend' }) %></span>
        <h2>Health Trends</h2>
        <p class="text-muted">Review campus-wide health analytics and symptom distribution data.</p>
        <a href="/trends" class="btn btn-primary">View Trends</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/profile" class="card-stretch" aria-label="My Profile"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'profile' }) %></span>
        <h2>My Profile</h2>
        <p class="text-muted">View and manage your account details and clinic assignment.</p>
        <a href="/profile" class="btn btn-primary">View Profile</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/management/nurse/availability" class="card-stretch" aria-label="Manage Availability"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'appointment' }) %></span>
        <h2>Manage Availability</h2>
        <p class="text-muted">Set your weekly available time slots for student bookings.</p>
        <a href="/management/nurse/availability" class="btn btn-primary">Set Availability</a>
      </section>
    </div>

  <% } else if (user.role === 'admin') { %>

    <div class="dashboard-grid">
      <section class="content-card reveal card-clickable">
        <a href="/management/admin/reports" class="card-stretch" aria-label="Operational Reports"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'report' }) %></span>
        <h2>Operational Reports</h2>
        <p class="text-muted">View system-wide analytics: appointments, ratings, and staff performance.</p>
        <a href="/management/admin/reports" class="btn btn-primary">View Reports</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/trends" class="card-stretch" aria-label="Health Trends"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'trend' }) %></span>
        <h2>Health Trends</h2>
        <p class="text-muted">Campus health overview with aggregated symptom data and zone mapping.</p>
        <a href="/trends" class="btn btn-primary">View Trends</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/management/admin/students" class="card-stretch" aria-label="Manage Students"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'manage.student' }) %></span>
        <h2>Manage Students</h2>
        <p class="text-muted">View, add, or remove student accounts from the system.</p>
        <a href="/management/admin/students" class="btn btn-primary">Manage Students</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/management/admin/nurses" class="card-stretch" aria-label="Manage Nurses"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'manage.nurse' }) %></span>
        <h2>Manage Nurses</h2>
        <p class="text-muted">Add, edit, or remove nurse staff accounts and clinic assignments.</p>
        <a href="/management/admin/nurses" class="btn btn-primary">Manage Nurses</a>
      </section>

      <section class="content-card reveal card-clickable">
        <a href="/profile" class="card-stretch" aria-label="My Profile"></a>
        <span class="card-watermark" aria-hidden="true"><%- include('./partials/icon', { name: 'profile' }) %></span>
        <h2>My Profile</h2>
        <p class="text-muted">View your admin account details.</p>
        <a href="/profile" class="btn btn-primary">View Profile</a>
      </section>
    </div>

  <% } %>

</main>

<%- include('./partials/footer') %>
